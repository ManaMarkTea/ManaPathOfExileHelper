{
  "name": "poe-price-check",
  "version": "1.0.0",
  "description": "Paste a Path of Exile item, get a live sell price estimate from the official trade site.",
  "main": "main.js",
  "author": "ManaMarkTea",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.manamarktea.poepricecheck",
    "productName": "PoE Price Check",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    }
  }
}
